# Copy this file to .env and fill in real values. .env is gitignored and must
# never be committed. Every variable the project reads is documented here.

# --- Ingest service ---

# Bearer token the OTLP receiver requires on every ingest request. Generate a
# long random value, for example: openssl rand -hex 32
OVERSEER_INGEST_TOKEN=

# Host and port the ingest HTTP server binds to.
OVERSEER_INGEST_HOST=127.0.0.1
OVERSEER_INGEST_PORT=4318

# Path to the SQLite database file. The directory must exist and be writable.
OVERSEER_DB_PATH=./data/overseer.db

# Maximum accepted request body size in bytes. Oversized bodies are rejected
# before parsing. Defaults to 5 MB if unset.
OVERSEER_MAX_BODY_BYTES=5242880

# Maximum spans accepted in a single OTLP request. Excess is rejected.
OVERSEER_MAX_SPANS_PER_REQUEST=1000

# Maximum attributes kept per span. Extra attributes are dropped after this.
OVERSEER_MAX_ATTRS_PER_SPAN=128

# Request read timeout in milliseconds.
OVERSEER_REQUEST_TIMEOUT_MS=10000

# Redaction mode: "scrub" runs the regex scrubbers (default), "allowlist" keeps
# only attributes named in OVERSEER_ATTR_ALLOWLIST and scrubs the rest.
OVERSEER_REDACTION_MODE=scrub

# Comma-separated attribute keys kept verbatim in allowlist mode. Ignored in
# scrub mode.
OVERSEER_ATTR_ALLOWLIST=

# --- SDK / example agent ---

# Where the SDK and example agent send OTLP traces.
OVERSEER_OTLP_ENDPOINT=http://127.0.0.1:4318/v1/traces

# Bearer token the SDK sends. Usually the same value as OVERSEER_INGEST_TOKEN.
OVERSEER_SDK_TOKEN=

# --- Alerts ---

# Discord (or Slack-compatible) incoming webhook URL that alerts are posted to.
# This comes from config only, never from ingested telemetry.
OVERSEER_ALERT_WEBHOOK_URL=

# --- Web dashboard ---

# Base URL of the ingest REST API the dashboard reads from.
OVERSEER_API_BASE_URL=http://127.0.0.1:4318

# When "true", the dashboard runs read-only against a bundled snapshot and the
# ingest route is not mounted. Used for the public demo deployment.
OVERSEER_READ_ONLY=false
